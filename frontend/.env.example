# ---------------------------------------------------------------- Lazarus Checker (/, Ethereum mainnet)
# Ethereum JSON-RPC endpoint used for read calls.
# Defaults to https://eth.llamarpc.com when unset.
# Example: https://eth-mainnet.g.alchemy.com/v2/<key> or https://mainnet.infura.io/v3/<key>
VITE_RPC_URL=

# Override the deployed KimJongUn contract address. Defaults to the value baked into src/lib/contract.ts.
VITE_KIM_JONG_UN_ADDRESS=

# ---------------------------------------------------------------- Launchpad (/launchpad, BNB Chain)
# Everything below is optional. With no launchpad address the /launchpad routes show
# "not deployed on this network yet" instead of crashing. `forge script script/DeployDprkFun.s.sol`
# prints these lines for the chain it deployed to.

# 56 (BNB Smart Chain, default) | 97 (BSC testnet) | 31337 (local anvil)
VITE_LAUNCHPAD_CHAIN_ID=
# RPC for that chain. Defaults: bsc-dataseed.bnbchain.org + bsc-rpc.publicnode.com (56),
# data-seed-prebsc-1-s1.bnbchain.org + bsc-testnet-rpc.publicnode.com (97), http://127.0.0.1:8545 (31337).
# A hosted key here is visible in the bundle, like every VITE_* value.
VITE_LAUNCHPAD_RPC_URL=
# KimJongUn registry on the launchpad chain. Optional: read from pass.kimJongUn() when unset.
VITE_DPRK_KIM_JONG_UN_ADDRESS=
# Not-Lazarus Pass. Optional: read from launchpad.pass() when unset.
VITE_DPRK_PASS_ADDRESS=
# The launchpad itself. Required for the launchpad UI.
VITE_DPRK_LAUNCHPAD_ADDRESS=
# Block the launchpad was deployed in: lower bound for the recent-trades log scan.
VITE_DPRK_DEPLOY_BLOCK=

# ---------------------------------------------------------------- Local e2e only
# "1" registers wagmi's mock connector as anvil account #0 (0xf39F…2266), which anvil signs for, so a
# headless browser can send real transactions. Only takes effect when the launchpad RPC is local
# (127.0.0.1/localhost). Never set this for a deployed build.
VITE_E2E_MOCK_WALLET=
